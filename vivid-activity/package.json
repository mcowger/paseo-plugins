{
  "name": "vivid-activity",
  "version": "0.11.0",
  "description": "Vivid Activity: color-coded, folding, timed activity rows for Paseo agent chats (based on Colorful Agent Activity by Matt Cowger)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:chunks": "node scripts/build-client-chunks.mjs",
    "check": "npm run build:chunks -- --check"
  },
  "dependencies": {
    "@getpaseo/protocol": "0.11.1",
    "prismjs": "^1.30.0"
  },
  "devDependencies": {
    "@getpaseo/client": "0.11.1",
    "@getpaseo/plugin": "0.11.1",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^20.9.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "~19.2.0",
    "esbuild": "^0.25.0",
    "oxlint": "1.61.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  }
}
